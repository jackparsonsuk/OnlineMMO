# Copy to .env and fill in before deploying. Nothing here is read in
# development except by choice — the defaults are aimed at localhost.

# Signs session tokens. REQUIRED in production; the server refuses to start
# without it, because a predictable secret lets anyone forge a login.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Names this deployment. Characters are scoped to it, so two servers sharing a
# database still give players two separate worlds.
REALM_ID=local

PORT=2567

# Where the SQLite file lives. In Docker this is a mounted volume.
DATABASE_FILE=data/ostracon.db

# Extra origins allowed to call the HTTP API, comma separated. Leave EMPTY in
# production: the server serves the client from its own origin, so there is no
# cross-origin call to permit and an empty list denies everyone else.
# ALLOWED_ORIGINS=https://play.example.com

NODE_ENV=production
